          "name": "Exchange authorization code for access token",
          "request": {
            "name": "Exchange authorization code for access token",
            "description": {
              "content": "Fly.io platform OAuth token endpoint. Exchanges an authorization code obtained from the authorize endpoint for an access token that can be used to retrieve user and organization information via the token info endpoint.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "oauth",
                "token"
              ],
              "host": [
                "api",
                "fly",
                "io"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) OAuth grant type. Must be authorization_code."
                },
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "(Required) The authorization code received from the authorize endpoint."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<string>",
                  "description": "(Required) The same redirect URI used in the authorization request."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) OAuth client ID issued to the provider."
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "(Required) OAuth client secret issued to the provider."
                }
              ]
