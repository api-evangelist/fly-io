      "item": [
        {
          "id": "c1021a54-ae60-4411-92ee-7db99f1aa61c",
          "name": "OAuth authorization endpoint",
          "request": {
            "name": "OAuth authorization endpoint",
            "description": {
              "content": "Fly.io platform OAuth authorization endpoint. Redirects the user to approve the OAuth application and returns an authorization code to the specified redirect URI. Used by extension providers during the SSO flow to verify Fly.io user identity.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "oauth",
                "authorize"
              ],
              "host": [
                "api",
                "fly",
                "io"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) OAuth client ID issued to the extension provider by Fly.io."
                },
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) OAuth response type. Must be code for the authorization code flow."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "(Required) Provider callback URL to redirect the user to after authorization."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "Space-separated list of requested OAuth scopes."
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
          "response": [
