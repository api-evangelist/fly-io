        {
          "id": "de4f4485-63d3-4ace-930d-f8bdda660a86",
          "name": "Receive a machine event webhook from Fly.io",
          "request": {
            "name": "Receive a machine event webhook from Fly.io",
            "description": {
              "content": "Fly.io sends CloudEvents-format webhook payloads to this provider endpoint when Machine or account events occur that are relevant to an extension. Providers should verify the HMAC-SHA256 signature using the webhook signing secret provided by Fly.io and process the event accordingly.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "extensions",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The base URL registered by the extension provider with Fly.io.",
                  "type": "any",
                  "value": "{{provider_base_url}}",
                  "key": "provider_base_url"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
