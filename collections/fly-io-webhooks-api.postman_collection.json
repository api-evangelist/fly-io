  "item": [
    {
      "id": "5e5f5c72-5d18-47cd-a5e0-5be77cb145ed",
      "name": "Webhooks",
      "description": {
        "content": "Webhook endpoints for bidirectional event delivery between Fly.io and extension providers. Both sides sign their webhook payloads using HMAC-SHA256 for verification.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2b73c2f3-2db8-476c-ac38-02eddb230944",
          "name": "Send a webhook to Fly.io",
          "request": {
            "name": "Send a webhook to Fly.io",
            "description": {
              "content": "Called by extension providers to notify Fly.io of resource lifecycle changes. Use this endpoint to report when asynchronously provisioned resources become ready, when resources are updated, or when they are deleted. Requests must be signed with the HMAC-SHA256 webhook signing secret provided by Fly.io.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "api",
                "hooks",
                "extensions",
                ":provider_name"
              ],
              "host": [
                "api",
                "fly",
                "io"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "provider_name",
                  "description": "(Required) The slug identifier of the extension provider registered with Fly.io."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Fly-Signature"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"<string>\",\n  \"resource_id\": \"<string>\",\n  \"config\": {\n    \"key_0\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
